# Conexão da aplicação (web e worker): papel membro de controle_vendas_estoque_app, sujeito ao RLS.
DATABASE_URL=postgres://controle_vendas_estoque_app_login:app@localhost:5432/erp_dev

# Conexão usada só pelas migrations: papel dono das tabelas.
MIGRATION_DATABASE_URL=postgres://erp_owner:erp@localhost:5432/erp_dev

# Testes (banco descartável; os testes recriam o schema controle_vendas_estoque).
TEST_OWNER_DATABASE_URL=postgres://erp_owner:erp@localhost:5432/erp_test
TEST_DATABASE_URL=postgres://controle_vendas_estoque_app_login:app@localhost:5432/erp_test

# Worker
WORKER_POLL_MS=2000

# Rota do Claude no quadro Melhorias (mínimo de 32 caracteres; vazio fecha a rota).
CLAUDE_IMPROVEMENTS_TOKEN=
