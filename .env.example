# Conexão da aplicação (web e worker): papel membro de erp_app, sujeito ao RLS.
DATABASE_URL=postgres://erp_app_login:app@localhost:5432/erp_dev

# Conexão usada só pelas migrations: papel dono das tabelas.
MIGRATION_DATABASE_URL=postgres://erp_owner:erp@localhost:5432/erp_dev

# Testes (banco descartável; os testes recriam o schema erp).
TEST_OWNER_DATABASE_URL=postgres://erp_owner:erp@localhost:5432/erp_test
TEST_DATABASE_URL=postgres://erp_app_login:app@localhost:5432/erp_test

# Worker
WORKER_POLL_MS=2000
